      <column caption='평수구간' datatype='string' name='[Calculation_694117337614102535]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [전용면적(평)] &lt; 20 THEN &quot;20평 미만&quot;&#13;&#10;ELSEIF [전용면적(평)] &lt; 30 THEN &quot;20~30평&quot;&#13;&#10;ELSEIF [전용면적(평)] &lt; 40 THEN &quot;30~40평&quot;&#13;&#10;ELSEIF [전용면적(평)] &lt; 50 THEN &quot;40~50평&quot;&#13;&#10;ELSE &quot;50평 이상&quot;&#13;&#10;END' />
