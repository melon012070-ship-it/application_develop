      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1rbpvf70nviaki16j1rz70ztnal0].[cnt:거래번호:qk]&quot;' value='거래건수' />
        </aliases>
      </column>
      <column caption='예상 현재시세' datatype='real' name='[Calculation_1089589679999651843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1869838315349721090] * (1 + [Parameters].[보유연수(복사본)]) ^ [Parameters].[Data 매개 변수]' />
      </column>
      <column caption='구매대비 상승금액' datatype='real' name='[Calculation_1089589679999889412]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1089589679999651843]-[Calculation_1869838315349721090]' />
      </column>
      <column caption='세전수익' datatype='real' name='[Calculation_1089589679999975429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1089589679999889412] - [Calculation_1666050432153010185]' />
      </column>
      <column caption='기준가격' datatype='real' name='[Calculation_1089589680002994182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1869838315349721090] + [Calculation_1666050432156782614]) / 2' />
      </column>
      <column caption='구매대비 현재시세' datatype='real' name='[Calculation_1089589680003227655]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1089589680002994182] * (1 + [Parameters].[매개 변수 2]) ^ [Parameters].[Data 매개 변수]' />
      </column>
      <column caption='누적비용' datatype='real' name='[Calculation_1089589680003334152]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(([Calculation_1666050432153010185] * [Parameters].[Data 매개 변수]) / 10000 , 2)' />
      </column>
      <column caption='세전금액' datatype='real' name='[Calculation_1089589680003428361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1089589680003227655] - [Calculation_1089589680002994182] - [Calculation_1089589680003334152]' />
      </column>
      <column caption='세전수익 %' datatype='real' name='[Calculation_1089589680003481610]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1089589680003428361] / [Calculation_1089589680002994182]' />
      </column>
      <column caption='상승률' datatype='real' name='[Calculation_1089589680022683659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF YEAR([거래일자]) = 2023 THEN [거래금액(만원)] END)&#13;&#10;-&#13;&#10;SUM(IF YEAR([거래일자]) = 2018 THEN [거래금액(만원)] END))&#13;&#10;/&#13;&#10;SUM(IF YEAR([거래일자]) = 2018 THEN [거래금액(만원)] END)' />
      </column>
      <column caption='연도' datatype='integer' name='[Calculation_1089589680026005516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([거래일자])' />
      </column>
      <column caption='emd_T' datatype='boolean' name='[Calculation_1426515226959953921]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='LEFT(STR([EMD_CD]), 2) = &quot;11&quot;' />
      </column>
      <column caption='중개수수료(단위:만)' datatype='real' name='[Calculation_1666050432148434945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(&#13;&#10;    IF [거래금액(만원)] &lt; 5000 THEN [거래금액(만원)] * 0.006&#13;&#10;    ELSEIF [거래금액(만원)] &lt; 20000 THEN [거래금액(만원)] * 0.005&#13;&#10;    ELSEIF [거래금액(만원)] &lt; 90000 THEN [거래금액(만원)] * 0.004&#13;&#10;    ELSEIF [거래금액(만원)] &lt; 120000 THEN [거래금액(만원)] * 0.005&#13;&#10;    ELSEIF [거래금액(만원)] &lt; 150000 THEN [거래금액(만원)] * 0.006&#13;&#10;    ELSE [거래금액(만원)] * 0.007&#13;&#10;    END,&#13;&#10;    IF [거래금액(만원)] &lt; 5000 THEN 25&#13;&#10;    ELSEIF [거래금액(만원)] &lt; 20000 THEN 80&#13;&#10;    ELSE 999999&#13;&#10;    END&#13;&#10;) * 1.1' />
      </column>
      <column caption='취득세(단위:만)' datatype='real' name='[Calculation_1666050432150798338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [거래금액(만원)] &lt;= 6000 THEN &#13;&#10;    [거래금액(만원)] * 0.01&#13;&#10;ELSEIF [거래금액(만원)] &lt;= 9000 THEN &#13;&#10;    [거래금액(만원)] * (([거래금액(만원)] / 3000 - 2) / 100)&#13;&#10;ELSEIF [거래금액(만원)] &gt; 9000 THEN &#13;&#10;    [거래금액(만원)] * 0.03&#13;&#10;END' />
      </column>
      <column caption='지방세(단위:만)' datatype='real' name='[Calculation_1666050432151252995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1666050432150798338] * 0.1) + IF [전용면적(평)] &gt; 85 THEN [거래금액(만원)] * 0.002 ELSE 0 END' />
      </column>
      <column caption='채권매입금액' datatype='real' name='[Calculation_1666050432151515140]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(([거래금액(만원)] * 0.7) * 0.031 * 0.1211, 0)' />
      </column>
      <column caption='법무사비용(단위:만)' datatype='real' name='[Calculation_1666050432151957509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND((21 + ([거래금액(만원)] - 5000) * 0.001) * 1.1, 0)' />
      </column>
      <column caption='인지세(단위:만)' datatype='integer' name='[Calculation_1666050432152231943]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [거래금액(만원)] &lt;= 10000 THEN 7&#13;&#10;ELSEIF [거래금액(만원)] &lt;= 100000 THEN 15&#13;&#10;ELSE 35&#13;&#10;END' />
      </column>
      <column caption='기타행정비용(단위:만)' datatype='real' name='[Calculation_1666050432153010185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//32만원(기타행정비용 등기 세금 채권 대행료 일당 교통비 증명서) + 1.5만원(수입중지) = 33.5만원 고정값&#13;&#10;33.5' />
      </column>
      <column caption='부대비용합계(단위:만)' datatype='real' name='[Calculation_1666050432154034190]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 안전한 버전: 값이 없는 항목을 0으로 처리하여 계산&#13;&#10;ZN([Calculation_1666050432150798338]) + ZN([Calculation_1666050432151252995]) + ZN([Calculation_1666050432151515140]) + &#13;&#10;ZN([Calculation_1666050432151957509]) + ZN([Calculation_1666050432152231943]) + ZN([Calculation_1666050432153010185])' />
      </column>
      <column caption='재산세(단위:만)' datatype='real' name='[Calculation_1666050432154378255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 거래금액의 60%를 기준으로 구간별 재산세 산출 및 반올림&#13;&#10;ROUND(&#13;&#10;    IF ([거래금액(만원)] * 0.6) &lt;= 6000 THEN &#13;&#10;        ([거래금액(만원)] * 0.6) * 0.0005&#13;&#10;    ELSEIF ([거래금액(만원)] * 0.6) &lt;= 15000 THEN &#13;&#10;        3 + (([거래금액(만원)] * 0.6) - 6000) * 0.001&#13;&#10;    ELSEIF ([거래금액(만원)] * 0.6) &lt;= 30000 THEN &#13;&#10;        12 + (([거래금액(만원)] * 0.6) - 15000) * 0.002&#13;&#10;    ELSE &#13;&#10;        57 + (([거래금액(만원)] * 0.6) - 30000) * 0.004&#13;&#10;    END&#13;&#10;, 0)' />
      </column>
      <column caption='종부세(단위:만)' datatype='real' name='[Calculation_1666050432154591248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 1. 과세표준 계산 (공시가격 60%에서 12억 공제 후 다시 60% 적용)&#13;&#10;// 2. 구간별 세율 적용 및 공제액 차감&#13;&#10;// 3. 재산세 중복분 차감 후 20% 가산(1.2) 및 반올림&#13;&#10;&#13;&#10;ROUND(&#13;&#10;    MAX(0, &#13;&#10;        (&#13;&#10;            IF (([거래금액(만원)] * 0.6 - 120000) * 0.6) &lt;= 30000 THEN &#13;&#10;                (([거래금액(만원)] * 0.6 - 120000) * 0.6) * 0.005&#13;&#10;            ELSEIF (([거래금액(만원)] * 0.6 - 120000) * 0.6) &lt;= 60000 THEN &#13;&#10;                (([거래금액(만원)] * 0.6 - 120000) * 0.6) * 0.007 - 60&#13;&#10;            ELSEIF (([거래금액(만원)] * 0.6 - 120000) * 0.6) &lt;= 120000 THEN &#13;&#10;                (([거래금액(만원)] * 0.6 - 120000) * 0.6) * 0.01 - 240&#13;&#10;            ELSEIF (([거래금액(만원)] * 0.6 - 120000) * 0.6) &lt;= 250000 THEN &#13;&#10;                (([거래금액(만원)] * 0.6 - 120000) * 0.6) * 0.013 - 600&#13;&#10;            ELSEIF (([거래금액(만원)] * 0.6 - 120000) * 0.6) &lt;= 500000 THEN &#13;&#10;                (([거래금액(만원)] * 0.6 - 120000) * 0.6) * 0.015 - 1100&#13;&#10;            ELSEIF (([거래금액(만원)] * 0.6 - 120000) * 0.6) &lt;= 940000 THEN &#13;&#10;                (([거래금액(만원)] * 0.6 - 120000) * 0.6) * 0.02 - 3600&#13;&#10;            ELSE &#13;&#10;                (([거래금액(만원)] * 0.6 - 120000) * 0.6) * 0.027 - 10180&#13;&#10;            END&#13;&#10;            - (MAX(0, [거래금액(만원)] * 0.6 - 120000) * 0.6 * 0.0015)&#13;&#10;        ) * 1.2&#13;&#10;    )&#13;&#10;, 0)' />
      </column>
      <column caption='부하율%' datatype='real' name='[Calculation_1666050432154914833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// 관리비 제외한 연간 보유시 필요한 비율 % &#13;&#10;(([Calculation_1666050432154378255] + [Calculation_1666050432154591248]) / [거래금액(만원)]) * 100' />
      </column>
      <column caption='세전수익률%' datatype='real' name='[Calculation_1666050432155463698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(((SUM([거래금액(만원)]) * POWER(1 + [Parameters].[보유연수(복사본)], [Parameters].[Data 매개 변수])) - SUM([Calculation_1666050432156438548])) &#13;&#10;/ SUM([Calculation_1666050432156438548])) / 100' />
      </column>
      <column caption='총소요비용' datatype='real' name='[Calculation_1666050432156438548]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[거래금액(만원)] + [Calculation_1666050432154034190] + (([Calculation_1666050432154378255] + [Calculation_1666050432154591248]) * [Parameters].[Data 매개 변수])' />
      </column>
      <column caption='세전수익률 (단위:만)' datatype='real' name='[Calculation_1666050432156651541]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([거래금액(만원)]) * POWER(1 + [Parameters].[보유연수(복사본)], [Parameters].[Data 매개 변수])) - SUM([Calculation_1666050432156438548])' />
      </column>
      <column caption='최소판매가' datatype='real' name='[Calculation_1666050432156782614]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([거래금액(만원)]) * POWER(1 + [Parameters].[보유연수(복사본)], [Parameters].[Data 매개 변수])' />
      </column>
      <column caption='연식' datatype='integer' name='[Calculation_1869838315348168704]' role='measure' type='quantitative'>
