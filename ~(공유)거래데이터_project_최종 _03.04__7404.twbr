    <worksheet name='시트 20'>
      <table>
        <view>
          <datasources>
            <datasource caption='Data+(다중 연결)' name='federated.1rbpvf70nviaki16j1rz70ztnal0' />
            <datasource caption='매개 변수' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='보유연수 (년)' datatype='integer' name='[Data 매개 변수]' param-domain-type='any' role='measure' type='quantitative' value='3'>
              <calculation class='tableau' formula='3' />
            </column>
            <column caption='연식수익률' datatype='real' name='[매개 변수 2]' param-domain-type='any' role='measure' type='quantitative' value='0.5'>
              <calculation class='tableau' formula='0.5' />
            </column>
            <column caption='예상상승률' datatype='real' default-format='p0.00%' name='[보유연수(복사본)]' param-domain-type='range' role='measure' type='quantitative' value='0.16'>
              <calculation class='tableau' formula='0.16' />
              <range granularity='0.01' max='0.2' min='-0.1' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1rbpvf70nviaki16j1rz70ztnal0'>
            <column caption='기준가격' datatype='real' name='[Calculation_1089589680002994182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1869838315349721090] + [Calculation_1666050432156782614]) / 2' />
            </column>
            <column caption='구매대비 현재시세' datatype='real' name='[Calculation_1089589680003227655]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1089589680002994182] * (1 + [Parameters].[매개 변수 2]) ^ [Parameters].[Data 매개 변수]' />
            </column>
            <column caption='누적비용' datatype='real' name='[Calculation_1089589680003334152]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(([Calculation_1666050432153010185] * [Parameters].[Data 매개 변수]) / 10000 , 2)' />
            </column>
            <column caption='세전금액' datatype='real' name='[Calculation_1089589680003428361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1089589680003227655] - [Calculation_1089589680002994182] - [Calculation_1089589680003334152]' />
            </column>
            <column caption='세전수익 %' datatype='real' name='[Calculation_1089589680003481610]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1089589680003428361] / [Calculation_1089589680002994182]' />
            </column>
            <column caption='연도' datatype='integer' name='[Calculation_1089589680026005516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR([거래일자])' />
            </column>
            <column caption='기타행정비용(단위:만)' datatype='real' name='[Calculation_1666050432153010185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//32만원(기타행정비용 등기 세금 채권 대행료 일당 교통비 증명서) + 1.5만원(수입중지) = 33.5만원 고정값&#13;&#10;33.5' />
            </column>
            <column caption='최소판매가' datatype='real' name='[Calculation_1666050432156782614]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([거래금액(만원)]) * POWER(1 + [Parameters].[보유연수(복사본)], [Parameters].[Data 매개 변수])' />
            </column>
            <column caption='최고매매가(억)' datatype='real' name='[Calculation_1869838315349721090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(MAX([거래금액(만원)]) / 10000,1)' />
            </column>
            <column-instance column='[Calculation_1089589680026005516]' derivation='None' name='[none:Calculation_1089589680026005516:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1089589680003334152]' derivation='Sum' name='[sum:Calculation_1089589680003334152:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1089589680003227655]' derivation='User' name='[usr:Calculation_1089589680003227655:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1089589680003428361]' derivation='User' name='[usr:Calculation_1089589680003428361:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1089589680003481610]' derivation='User' name='[usr:Calculation_1089589680003481610:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1666050432156782614]' derivation='User' name='[usr:Calculation_1666050432156782614:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[거래금액(만원)]' role='measure' type='quantitative' />
