package Hellowordl;

public class main {
	public static void main(String[] args) {
		public class Main {
		    public static void main(String[] args) {
		        Animal a = new Animal();
		        Dog d = new Dog();
		        Cat c = new Cat();
		        Tiger t = new Tiger();
		        Animal ac = new Cat();
		        Cat cc = (Cat) ac;

		        // instanceof 연산자를 사용하여 객체의 타입을 확인
		        System.out.println(a instanceof Animal); // true
		        System.out.println(d instanceof Dog);    // true
		        System.out.println(t instanceof Cat);    // false
		        System.out.println(ac instanceof Animal); // true
		        System.out.println(cc instanceof Tiger); // false
		    }
		}

}
}
